@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity

@if (User?.Identity?.IsAuthenticated ?? false)
{
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
        @Html.AntiForgeryToken()
        <span class="navbar-text me-2">Olá, @User.Identity.Name</span>
        <button type="submit" class="btn btn-link nav-link p-0">Logout</button>
    </form>
}
else
{
    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
}